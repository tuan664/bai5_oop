using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Net;
using System.Text;

public enum DeviceStatus
{
    Active,
    UnderMaintenance,
    Retired
}

public enum PrinterType
{
    Laser,
    Inkjet
}

// Interface biểu diễn khả năng kết nối mạng.
public interface INetworkable
{
    string IpAddress { get; }
    void Connect(string ipAddress);
    void Disconnect();
    bool IsConnected { get; }
}

// Thành phần quản lý kết nối mạng, được sử dụng bởi các thiết bị có mạng.
public sealed class NetworkConnection
{
    public string IpAddress { get; private set; } = "";
    public bool IsConnected { get; private set; }

    public void Connect(string ipAddress)
    {
        if (string.IsNullOrWhiteSpace(ipAddress))
            throw new ArgumentException("Địa chỉ IP không được rỗng.");

        if (!IPAddress.TryParse(ipAddress.Trim(), out _))
            throw new ArgumentException("Địa chỉ IP không đúng định dạng.");

        if (IsConnected)
            throw new InvalidOperationException(
                "Thiết bị đang kết nối mạng.");

        IpAddress = ipAddress.Trim();
        IsConnected = true;
    }

    public void Disconnect()
    {
        IpAddress = "";
        IsConnected = false;
    }
}

// Lớp trừu tượng chứa thông tin chung của các thiết bị.
public abstract class Device
{
    public string DeviceId { get; }
    public string Name { get; private set; }
    public int YearIntroduced { get; private set; }
    public decimal PurchasePrice { get; private set; }
    public DeviceStatus Status { get; private set; }

    protected Device(
        string deviceId,
        string name,
        int yearIntroduced,
        decimal purchasePrice,
        DeviceStatus status = DeviceStatus.Active)
    {
        if (string.IsNullOrWhiteSpace(deviceId))
            throw new ArgumentException(
                "Mã thiết bị không được rỗng.");

        if (string.IsNullOrWhiteSpace(name))
            throw new ArgumentException(
                "Tên thiết bị không được rỗng.");

        if (yearIntroduced < 1 ||
            yearIntroduced > DateTime.Now.Year)
            throw new ArgumentException(
                "Năm đưa vào sử dụng không hợp lệ.");

        if (purchasePrice <= 0)
            throw new ArgumentException(
                "Giá mua phải lớn hơn 0.");

        if (!Enum.IsDefined(typeof(DeviceStatus), status))
            throw new ArgumentException(
                "Trạng thái thiết bị không hợp lệ.");

        DeviceId = deviceId.Trim();
        Name = name.Trim();
        YearIntroduced = yearIntroduced;
        PurchasePrice = purchasePrice;
        Status = status;
    }

    public void UpdateStatus(DeviceStatus status)
    {
        if (!Enum.IsDefined(typeof(DeviceStatus), status))
            throw new ArgumentException(
                "Trạng thái thiết bị không hợp lệ.");

        Status = status;
    }

    public abstract decimal CalculateAnnualMaintenanceCost();

    public override string ToString()
    {
        return $"{DeviceId} | {Name} | " +
               $"Năm sử dụng: {YearIntroduced} | " +
               $"Giá mua: {PurchasePrice:N0} VND | " +
               $"Trạng thái: {Status}";
    }
}

// Máy tính luôn có khả năng kết nối mạng.
public class Computer : Device, INetworkable
{
    private readonly NetworkConnection _network =
        new NetworkConnection();

    public int RamGB { get; private set; }
    public string ProcessorType { get; private set; }
    public bool HasDedicatedGpu { get; private set; }

    public string IpAddress => _network.IpAddress;
    public bool IsConnected => _network.IsConnected;

    public Computer(
        string deviceId,
        string name,
        int yearIntroduced,
        decimal purchasePrice,
        int ramGB,
        string processorType,
        bool hasDedicatedGpu,
        DeviceStatus status = DeviceStatus.Active)
        : base(
            deviceId, name, yearIntroduced,
            purchasePrice, status)
    {
        if (ramGB <= 0)
            throw new ArgumentException(
                "Dung lượng RAM phải lớn hơn 0.");

        if (string.IsNullOrWhiteSpace(processorType))
            throw new ArgumentException(
                "Loại bộ xử lý không được rỗng.");

        RamGB = ramGB;
        ProcessorType = processorType.Trim();
        HasDedicatedGpu = hasDedicatedGpu;
    }

    public override decimal CalculateAnnualMaintenanceCost()
    {
        decimal cost = PurchasePrice * 0.05m;

        if (HasDedicatedGpu)
            cost += PurchasePrice * 0.02m;

        if (DateTime.Now.Year - YearIntroduced > 5)
            cost += PurchasePrice * 0.01m;

        return cost;
    }

    public void Connect(string ipAddress)
    {
        _network.Connect(ipAddress);
    }

    public void Disconnect()
    {
        _network.Disconnect();
    }

    public override string ToString()
    {
        return base.ToString() +
               $" | RAM: {RamGB} GB" +
               $" | CPU: {ProcessorType}" +
               $" | GPU rời: {(HasDedicatedGpu ? "Có" : "Không")}";
    }
}

// Máy in thông thường không bắt buộc có khả năng kết nối mạng.
public class Printer : Device
{
    public PrinterType Type { get; private set; }
    public int PagesPrinted { get; private set; }
    public bool IsColor { get; private set; }

    public virtual bool SupportsNetwork => false;

    public Printer(
        string deviceId,
        string name,
        int yearIntroduced,
        decimal purchasePrice,
        PrinterType type,
        int pagesPrinted,
        bool isColor,
        DeviceStatus status = DeviceStatus.Active)
        : base(
            deviceId, name, yearIntroduced,
            purchasePrice, status)
    {
        if (!Enum.IsDefined(typeof(PrinterType), type))
            throw new ArgumentException(
                "Loại máy in không hợp lệ.");

        if (pagesPrinted < 0)
            throw new ArgumentException(
                "Số trang đã in không được âm.");

        Type = type;
        PagesPrinted = pagesPrinted;
        IsColor = isColor;
    }

    public override decimal CalculateAnnualMaintenanceCost()
    {
        decimal cost = PurchasePrice * 0.04m;

        if (PagesPrinted > 100000)
            cost += 500000m;

        if (IsColor)
            cost += 300000m;

        return cost;
    }

    public override string ToString()
    {
        return base.ToString() +
               $" | Loại máy in: {Type}" +
               $" | Số trang: {PagesPrinted}" +
               $" | In màu: {(IsColor ? "Có" : "Không")}" +
               $" | Hỗ trợ mạng: {(SupportsNetwork ? "Có" : "Không")}";
    }
}

// Máy in có mạng kế thừa Printer và thực thi INetworkable.
public class NetworkPrinter : Printer, INetworkable
{
    private readonly NetworkConnection _network =
        new NetworkConnection();

    public override bool SupportsNetwork => true;

    public string IpAddress => _network.IpAddress;
    public bool IsConnected => _network.IsConnected;

    public NetworkPrinter(
        string deviceId,
        string name,
        int yearIntroduced,
        decimal purchasePrice,
        PrinterType type,
        int pagesPrinted,
        bool isColor,
        DeviceStatus status = DeviceStatus.Active)
        : base(
            deviceId, name, yearIntroduced,
            purchasePrice, type, pagesPrinted,
            isColor, status)
    {
    }

    public void Connect(string ipAddress)
    {
        _network.Connect(ipAddress);
    }

    public void Disconnect()
    {
        _network.Disconnect();
    }
}

// Máy chiếu.
public class Projector : Device
{
    public int BrightnessLumen { get; private set; }
    public int LampHours { get; private set; }

    public Projector(
        string deviceId,
        string name,
        int yearIntroduced,
        decimal purchasePrice,
        int brightnessLumen,
        int lampHours,
        DeviceStatus status = DeviceStatus.Active)
        : base(
            deviceId, name, yearIntroduced,
            purchasePrice, status)
    {
        if (brightnessLumen <= 0)
            throw new ArgumentException(
                "Độ sáng phải lớn hơn 0.");

        if (lampHours < 0)
            throw new ArgumentException(
                "Số giờ sử dụng bóng đèn không được âm.");

        BrightnessLumen = brightnessLumen;
        LampHours = lampHours;
    }

    public override decimal CalculateAnnualMaintenanceCost()
    {
        decimal cost = PurchasePrice * 0.03m;

        if (LampHours > 3000)
            cost += 1500000m;

        return cost;
    }

    public override string ToString()
    {
        return base.ToString() +
               $" | Độ sáng: {BrightnessLumen} lumen" +
               $" | Giờ sử dụng bóng đèn: {LampHours}";
    }
}

// Phòng thực hành quản lý tập hợp các thiết bị được phân bổ.
public class LabRoom
{
    private readonly List<Device> _devices =
        new List<Device>();

    public string RoomId { get; }
    public string RoomName { get; private set; }
    public int Capacity { get; }

    public LabRoom(
        string roomId,
        string roomName,
        int capacity)
    {
        if (string.IsNullOrWhiteSpace(roomId))
            throw new ArgumentException(
                "Mã phòng không được rỗng.");

        if (string.IsNullOrWhiteSpace(roomName))
            throw new ArgumentException(
                "Tên phòng không được rỗng.");

        if (capacity <= 0)
            throw new ArgumentException(
                "Sức chứa phải lớn hơn 0.");

        RoomId = roomId.Trim();
        RoomName = roomName.Trim();
        Capacity = capacity;
    }

    public void AddDevice(Device device)
    {
        if (device == null)
            throw new ArgumentNullException(nameof(device));

        if (_devices.Any(d =>
            string.Equals(
                d.DeviceId,
                device.DeviceId,
                StringComparison.OrdinalIgnoreCase)))
        {
            throw new InvalidOperationException(
                "Mã thiết bị đã tồn tại trong phòng.");
        }

        if (_devices.Count >= Capacity)
            throw new InvalidOperationException(
                "Phòng thực hành đã đủ sức chứa.");

        _devices.Add(device);
    }

    public bool RemoveDevice(string deviceId)
    {
        Device? device = FindDevice(deviceId);

        if (device == null)
            return false;

        return _devices.Remove(device);
    }

    public Device? FindDevice(string deviceId)
    {
        if (string.IsNullOrWhiteSpace(deviceId))
            return null;

        return _devices.FirstOrDefault(d =>
            string.Equals(
                d.DeviceId,
                deviceId.Trim(),
                StringComparison.OrdinalIgnoreCase));
    }

    // Sử dụng đa hình để tính chi phí của từng loại thiết bị.
    public decimal CalculateAnnualMaintenanceCost()
    {
        decimal total = 0;

        foreach (Device device in _devices)
            total += device.CalculateAnnualMaintenanceCost();

        return total;
    }

    public List<Device> GetDevicesRequiringMaintenance()
    {
        return _devices.Where(d =>
            d.Status == DeviceStatus.UnderMaintenance ||
            DateTime.Now.Year - d.YearIntroduced > 5
        ).ToList();
    }

    public IReadOnlyList<Device> GetDevices()
    {
        return _devices.AsReadOnly();
    }
}

public class Program
{
    private static readonly List<Device> Devices =
        new List<Device>();

    private static readonly List<LabRoom> Rooms =
        new List<LabRoom>();

    public static void Main()
    {
        Console.OutputEncoding = new UTF8Encoding(false);
        CultureInfo.CurrentCulture =
            CultureInfo.GetCultureInfo("vi-VN");

        LoadSampleData();

        while (true)
        {
            Console.WriteLine(
                "\n===== HỆ THỐNG QUẢN LÝ THIẾT BỊ VÀ BẢO TRÌ =====");
            Console.WriteLine("1. Thêm thiết bị");
            Console.WriteLine("2. Xem toàn bộ thiết bị");
            Console.WriteLine("3. Thêm phòng thực hành");
            Console.WriteLine("4. Xem danh sách phòng");
            Console.WriteLine("5. Phân bổ thiết bị vào phòng");
            Console.WriteLine("6. Xem thiết bị theo phòng");
            Console.WriteLine("7. Tìm kiếm thiết bị");
            Console.WriteLine("8. Xóa thiết bị khỏi phòng");
            Console.WriteLine("9. Báo cáo chi phí và thiết bị cần bảo trì");
            Console.WriteLine("10. Quản lý kết nối mạng");
            Console.WriteLine("11. Cập nhật trạng thái thiết bị");
            Console.WriteLine("0. Thoát");

            int choice = ReadIntInRange(
                "Chọn chức năng: ", 0, 11);

            if (choice == 0)
            {
                Console.WriteLine("Đã thoát chương trình.");
                return;
            }

            try
            {
                switch (choice)
                {
                    case 1:
                        AddDevice();
                        break;
                    case 2:
                        DisplayAllDevices();
                        break;
                    case 3:
                        AddRoom();
                        break;
                    case 4:
                        DisplayRooms();
                        break;
                    case 5:
                        AssignDevice();
                        break;
                    case 6:
                        DisplayRoomDevices();
                        break;
                    case 7:
                        FindDevice();
                        break;
                    case 8:
                        RemoveDeviceFromRoom();
                        break;
                    case 9:
                        MaintenanceReport();
                        break;
                    case 10:
                        NetworkMenu();
                        break;
                    case 11:
                        UpdateDeviceStatus();
                        break;
                }
            }
            catch (ArgumentException ex)
            {
                Console.WriteLine(
                    $"Dữ liệu không hợp lệ: {ex.Message}");
            }
            catch (InvalidOperationException ex)
            {
                Console.WriteLine(
                    $"Không thể thực hiện thao tác: {ex.Message}");
            }
        }
    }

    // Tạo dữ liệu ban đầu để kiểm tra các yêu cầu của đề bài.
    private static void LoadSampleData()
    {
        Device c1 = new Computer(
            "C001", "Máy tính A", 2022, 20000000m,
            16, "Intel Core i5", false);

        Device c2 = new Computer(
            "C002", "Máy tính B", 2018, 30000000m,
            32, "Intel Core i7", true,
            DeviceStatus.UnderMaintenance);

        Device p1 = new Printer(
            "P001", "Máy in laser", 2022, 5000000m,
            PrinterType.Laser, 50000, false);

        Device p2 = new NetworkPrinter(
            "P002", "Máy in màu có mạng", 2019, 8000000m,
            PrinterType.Inkjet, 150000, true);

        Device pj = new Projector(
            "PJ001", "Máy chiếu A", 2021, 15000000m,
            3500, 3500);

        Devices.AddRange(new[] { c1, c2, p1, p2, pj });

        LabRoom r1 = new LabRoom(
            "R01", "Phòng thực hành 1", 10);

        LabRoom r2 = new LabRoom(
            "R02", "Phòng thực hành 2", 10);

        r1.AddDevice(c1);
        r1.AddDevice(p1);
        r1.AddDevice(pj);

        r2.AddDevice(c2);
        r2.AddDevice(p2);

        Rooms.AddRange(new[] { r1, r2 });
    }

    private static void AddDevice()
    {
        Console.WriteLine("1. Máy tính");
        Console.WriteLine("2. Máy in");
        Console.WriteLine("3. Máy chiếu");

        int type = ReadIntInRange("Loại thiết bị: ", 1, 3);

        string id = ReadRequiredText("Mã thiết bị: ");
        EnsureUniqueDeviceId(id);

        string name = ReadRequiredText("Tên thiết bị: ");

        int year = ReadIntInRange(
            "Năm đưa vào sử dụng: ",
            1, DateTime.Now.Year);

        decimal price = ReadPositiveDecimal(
            "Giá mua (ví dụ 20000000): ");

        DeviceStatus status = ReadStatus();
        Device device;

        if (type == 1)
        {
            int ram = ReadIntInRange("RAM (GB): ", 1, 1024);
            string cpu = ReadRequiredText("Loại bộ xử lý: ");
            bool gpu = ReadYesNo("Có GPU rời không?");

            device = new Computer(
                id, name, year, price,
                ram, cpu, gpu, status);
        }
        else if (type == 2)
        {
            PrinterType printerType = ReadPrinterType();

            int pages = ReadIntInRange(
                "Số trang đã in: ", 0, int.MaxValue);

            bool color = ReadYesNo("Máy in màu?");
            bool network = ReadYesNo("Máy in hỗ trợ mạng?");

            if (network)
            {
                device = new NetworkPrinter(
                    id, name, year, price,
                    printerType, pages, color, status);
            }
            else
            {
                device = new Printer(
                    id, name, year, price,
                    printerType, pages, color, status);
            }
        }
        else
        {
            int lumen = ReadIntInRange(
                "Độ sáng (lumen): ", 1, int.MaxValue);

            int hours = ReadIntInRange(
                "Số giờ sử dụng bóng đèn: ",
                0, int.MaxValue);

            device = new Projector(
                id, name, year, price,
                lumen, hours, status);
        }

        Devices.Add(device);
        Console.WriteLine("Đã thêm thiết bị.");
    }

    private static void EnsureUniqueDeviceId(string id)
    {
        if (Devices.Any(d =>
            string.Equals(
                d.DeviceId,
                id.Trim(),
                StringComparison.OrdinalIgnoreCase)))
        {
            throw new InvalidOperationException(
                "Mã thiết bị đã tồn tại trong hệ thống.");
        }
    }

    private static void AddRoom()
    {
        string id = ReadRequiredText("Mã phòng: ");

        if (Rooms.Any(r =>
            string.Equals(
                r.RoomId, id.Trim(),
                StringComparison.OrdinalIgnoreCase)))
        {
            throw new InvalidOperationException(
                "Mã phòng đã tồn tại.");
        }

        string name = ReadRequiredText("Tên phòng: ");

        int capacity = ReadIntInRange(
            "Sức chứa: ", 1, int.MaxValue);

        Rooms.Add(new LabRoom(id, name, capacity));

        Console.WriteLine("Đã thêm phòng.");
    }

    private static void AssignDevice()
    {
        DisplayAllDevices();
        DisplayRooms();

        string id = ReadRequiredText(
            "Mã thiết bị cần phân bổ: ");

        string roomId = ReadRequiredText(
            "Mã phòng nhận thiết bị: ");

        Device? device = Devices.FirstOrDefault(d =>
            string.Equals(
                d.DeviceId, id.Trim(),
                StringComparison.OrdinalIgnoreCase));

        LabRoom? room = Rooms.FirstOrDefault(r =>
            string.Equals(
                r.RoomId, roomId.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (device == null)
            throw new InvalidOperationException(
                "Không tìm thấy thiết bị.");

        if (room == null)
            throw new InvalidOperationException(
                "Không tìm thấy phòng.");

        bool alreadyAssigned = Rooms.Any(r =>
            r.GetDevices().Any(d =>
                string.Equals(
                    d.DeviceId,
                    device.DeviceId,
                    StringComparison.OrdinalIgnoreCase)));

        if (alreadyAssigned)
            throw new InvalidOperationException(
                "Thiết bị đã được phân bổ vào một phòng.");

        room.AddDevice(device);

        Console.WriteLine("Đã phân bổ thiết bị vào phòng.");
    }

    private static void DisplayAllDevices()
    {
        if (Devices.Count == 0)
        {
            Console.WriteLine("Chưa có thiết bị.");
            return;
        }

        Console.WriteLine("\n===== DANH SÁCH THIẾT BỊ =====");

        foreach (Device device in Devices)
        {
            LabRoom? room = Rooms.FirstOrDefault(r =>
                r.GetDevices().Contains(device));

            Console.WriteLine(device);

            Console.WriteLine(
                room == null
                    ? "Phòng: Chưa phân bổ"
                    : $"Phòng: {room.RoomName}");

            Console.WriteLine();
        }
    }

    private static void DisplayRooms()
    {
        if (Rooms.Count == 0)
        {
            Console.WriteLine("Chưa có phòng.");
            return;
        }

        Console.WriteLine("\n===== DANH SÁCH PHÒNG =====");

        foreach (LabRoom room in Rooms)
        {
            Console.WriteLine(
                $"{room.RoomId} | {room.RoomName} | " +
                $"Sức chứa: {room.Capacity} | " +
                $"Số thiết bị: {room.GetDevices().Count}");
        }
    }

    private static void DisplayRoomDevices()
    {
        DisplayRooms();

        string id = ReadRequiredText("Mã phòng: ");

        LabRoom? room = Rooms.FirstOrDefault(r =>
            string.Equals(
                r.RoomId, id.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (room == null)
            throw new InvalidOperationException(
                "Không tìm thấy phòng.");

        Console.WriteLine($"\n===== {room.RoomName} =====");

        if (room.GetDevices().Count == 0)
        {
            Console.WriteLine("Phòng chưa có thiết bị.");
        }
        else
        {
            foreach (Device device in room.GetDevices())
            {
                Console.WriteLine(device);
                Console.WriteLine(
                    $"Chi phí bảo trì: " +
                    $"{device.CalculateAnnualMaintenanceCost():N0} VND");
            }
        }

        Console.WriteLine(
            $"Tổng chi phí bảo trì của phòng: " +
            $"{room.CalculateAnnualMaintenanceCost():N0} VND");
    }

    private static void FindDevice()
    {
        string id = ReadRequiredText("Mã thiết bị: ");

        Device? device = Devices.FirstOrDefault(d =>
            string.Equals(
                d.DeviceId, id.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (device == null)
            throw new InvalidOperationException(
                "Không tìm thấy thiết bị.");

        Console.WriteLine("\n===== THÔNG TIN THIẾT BỊ =====");
        Console.WriteLine(device);

        Console.WriteLine(
            $"Chi phí bảo trì dự kiến: " +
            $"{device.CalculateAnnualMaintenanceCost():N0} VND");

        LabRoom? room = Rooms.FirstOrDefault(r =>
            r.GetDevices().Contains(device));

        Console.WriteLine(
            room == null
                ? "Chưa phân bổ vào phòng."
                : $"Phòng: {room.RoomName}");
    }

    private static void RemoveDeviceFromRoom()
    {
        DisplayRooms();

        string roomId = ReadRequiredText("Mã phòng: ");

        LabRoom? room = Rooms.FirstOrDefault(r =>
            string.Equals(
                r.RoomId, roomId.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (room == null)
            throw new InvalidOperationException(
                "Không tìm thấy phòng.");

        string deviceId = ReadRequiredText(
            "Mã thiết bị cần bỏ khỏi phòng: ");

        if (!room.RemoveDevice(deviceId))
            throw new InvalidOperationException(
                "Không tìm thấy thiết bị trong phòng.");

        Console.WriteLine(
            "Đã bỏ thiết bị khỏi phòng. " +
            "Thiết bị vẫn được quản lý trong hệ thống.");
    }

    private static void MaintenanceReport()
    {
        if (Rooms.Count == 0)
        {
            Console.WriteLine("Chưa có phòng thực hành.");
            return;
        }

        Console.WriteLine("\n===== BÁO CÁO BẢO TRÌ =====");

        foreach (LabRoom room in Rooms)
        {
            Console.WriteLine(
                $"\nPhòng: {room.RoomName}");

            foreach (Device device in room.GetDevices())
            {
                Console.WriteLine(
                    $"{device.DeviceId} - {device.Name}: " +
                    $"{device.CalculateAnnualMaintenanceCost():N0} VND");
            }

            Console.WriteLine(
                $"Tổng chi phí: " +
                $"{room.CalculateAnnualMaintenanceCost():N0} VND");

            List<Device> needMaintenance =
                room.GetDevicesRequiringMaintenance();

            Console.WriteLine("Thiết bị cần bảo trì:");

            if (needMaintenance.Count == 0)
            {
                Console.WriteLine("Không có.");
            }
            else
            {
                foreach (Device device in needMaintenance)
                {
                    Console.WriteLine(
                        $"{device.DeviceId} - {device.Name}");
                }
            }
        }

        List<Device> unassigned = Devices
            .Where(d => !Rooms.Any(r =>
                r.GetDevices().Contains(d)))
            .ToList();

        if (unassigned.Count > 0)
        {
            Console.WriteLine("\nThiết bị chưa phân bổ vào phòng:");

            foreach (Device device in unassigned)
            {
                Console.WriteLine(
                    $"{device.DeviceId} - {device.Name} | " +
                    $"{device.CalculateAnnualMaintenanceCost():N0} VND");
            }
        }
    }

    private static void NetworkMenu()
    {
        while (true)
        {
            Console.WriteLine("\n===== QUẢN LÝ KẾT NỐI MẠNG =====");
            Console.WriteLine("1. Xem thiết bị có mạng");
            Console.WriteLine("2. Kết nối thiết bị");
            Console.WriteLine("3. Ngắt kết nối thiết bị");
            Console.WriteLine("0. Quay lại");

            int choice = ReadIntInRange(
                "Chọn chức năng: ", 0, 3);

            if (choice == 0)
                return;

            try
            {
                switch (choice)
                {
                    case 1:
                        DisplayNetworkDevices();
                        break;
                    case 2:
                        ConnectDevice();
                        break;
                    case 3:
                        DisconnectDevice();
                        break;
                }
            }
            catch (ArgumentException ex)
            {
                Console.WriteLine(
                    $"Dữ liệu không hợp lệ: {ex.Message}");
            }
            catch (InvalidOperationException ex)
            {
                Console.WriteLine(
                    $"Không thể thực hiện: {ex.Message}");
            }
        }
    }

    // Duyệt các đối tượng thông qua interface, không phụ thuộc lớp cụ thể.
    private static void DisplayNetworkDevices()
    {
        List<INetworkable> networkDevices =
            Devices.OfType<INetworkable>().ToList();

        if (networkDevices.Count == 0)
        {
            Console.WriteLine(
                "Không có thiết bị hỗ trợ mạng.");
            return;
        }

        foreach (INetworkable networkDevice in networkDevices)
        {
            Device device = Devices.First(d =>
                ReferenceEquals(d, networkDevice));

            Console.WriteLine(
                $"{device.DeviceId} - {device.Name} | " +
                $"Kết nối: {networkDevice.IsConnected} | " +
                $"IP: {networkDevice.IpAddress}");
        }
    }

    private static void ConnectDevice()
    {
        string id = ReadRequiredText("Mã thiết bị: ");

        Device? device = Devices.FirstOrDefault(d =>
            string.Equals(
                d.DeviceId, id.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (device == null)
            throw new InvalidOperationException(
                "Không tìm thấy thiết bị.");

        if (!(device is INetworkable))
            throw new InvalidOperationException(
                "Thiết bị không hỗ trợ kết nối mạng.");

        INetworkable network = (INetworkable)device;

        string ip = ReadRequiredText("Địa chỉ IP: ");

        network.Connect(ip);

        Console.WriteLine("Đã kết nối thiết bị.");
        Console.WriteLine($"IP: {network.IpAddress}");
        Console.WriteLine($"Đang kết nối: {network.IsConnected}");
    }

    private static void DisconnectDevice()
    {
        string id = ReadRequiredText("Mã thiết bị: ");

        Device? device = Devices.FirstOrDefault(d =>
            string.Equals(
                d.DeviceId, id.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (device == null)
            throw new InvalidOperationException(
                "Không tìm thấy thiết bị.");

        if (!(device is INetworkable))
            throw new InvalidOperationException(
                "Thiết bị không hỗ trợ kết nối mạng.");

        INetworkable network = (INetworkable)device;

        if (!network.IsConnected)
            throw new InvalidOperationException(
                "Thiết bị chưa kết nối mạng.");

        network.Disconnect();

        Console.WriteLine("Đã ngắt kết nối.");
        Console.WriteLine($"Đang kết nối: {network.IsConnected}");
        Console.WriteLine($"IP hiện tại: '{network.IpAddress}'");
    }

    private static void UpdateDeviceStatus()
    {
        string id = ReadRequiredText("Mã thiết bị: ");

        Device? device = Devices.FirstOrDefault(d =>
            string.Equals(
                d.DeviceId, id.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (device == null)
            throw new InvalidOperationException(
                "Không tìm thấy thiết bị.");

        DeviceStatus status = ReadStatus();
        device.UpdateStatus(status);

        Console.WriteLine("Đã cập nhật trạng thái thiết bị.");
    }

    private static string ReadRequiredText(string prompt)
    {
        while (true)
        {
            Console.Write(prompt);
            string value = Console.ReadLine() ?? "";

            if (!string.IsNullOrWhiteSpace(value))
                return value.Trim();

            Console.WriteLine(
                "Thông tin không được để trống.");
        }
    }

    private static int ReadIntInRange(
        string prompt, int min, int max)
    {
        while (true)
        {
            Console.Write(prompt);
            string input = Console.ReadLine() ?? "";

            if (int.TryParse(input, out int value) &&
                value >= min && value <= max)
            {
                return value;
            }

            Console.WriteLine(
                $"Vui lòng nhập số nguyên từ {min} đến {max}.");
        }
    }

    private static decimal ReadPositiveDecimal(string prompt)
    {
        while (true)
        {
            Console.Write(prompt);
            string input = Console.ReadLine() ?? "";

            if (decimal.TryParse(
                    input,
                    NumberStyles.AllowLeadingSign |
                    NumberStyles.AllowDecimalPoint,
                    CultureInfo.InvariantCulture,
                    out decimal value) &&
                value > 0)
            {
                return value;
            }

            Console.WriteLine(
                "Vui lòng nhập số lớn hơn 0, ví dụ 20000000.");
        }
    }

    private static bool ReadYesNo(string prompt)
    {
        Console.WriteLine(prompt);
        Console.WriteLine("1. Có");
        Console.WriteLine("2. Không");

        return ReadIntInRange("Chọn: ", 1, 2) == 1;
    }

    private static DeviceStatus ReadStatus()
    {
        Console.WriteLine("Trạng thái thiết bị:");
        Console.WriteLine("1. Đang hoạt động");
        Console.WriteLine("2. Đang bảo trì");
        Console.WriteLine("3. Đã thanh lý");

        int choice = ReadIntInRange("Chọn: ", 1, 3);

        switch (choice)
        {
            case 1:
                return DeviceStatus.Active;
            case 2:
                return DeviceStatus.UnderMaintenance;
            default:
                return DeviceStatus.Retired;
        }
    }

    private static PrinterType ReadPrinterType()
    {
        Console.WriteLine("Loại máy in:");
        Console.WriteLine("1. Laser");
        Console.WriteLine("2. Phun");

        int choice = ReadIntInRange("Chọn: ", 1, 2);

        return choice == 1
            ? PrinterType.Laser
            : PrinterType.Inkjet;
    }
}
